# Sepolia testnet deployment (Phase 0)
# Public RPC needs no API key; swap for a dedicated provider before mainnet.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer wallet private key (0x-prefixed, 32 bytes). Testnet-only key —
# never reuse for anything else, never commit.
SEPOLIA_PRIVATE_KEY=

# Optional: anchor-service wallet allowed to call anchorRoot().
# Defaults to the deployer address when unset.
# ANCHORER_ADDRESS=
