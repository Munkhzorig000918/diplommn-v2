# --- Database (docker-compose defaults) ---
DATABASE_URL=postgres://diplommn:diplommn_dev@localhost:5433/diplommn

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO in dev; NDC object storage in prod) ---
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=diplommn
S3_SECRET_KEY=diplommn_dev
S3_BUCKET=diplommn-artifacts

# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
# Cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-0000000000000000
SESSION_TTL_HOURS=12
# Set to "true" only behind HTTPS (production)
COOKIE_SECURE=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# --- Bootstrap platform admin (used once by db:seed; change immediately) ---
BOOTSTRAP_ADMIN_EMAIL=admin@diplom.mn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Now-1234

# --- Public verification disclosure policy (architecture gap #19 — pending legal review) ---
# masked  = surname initial + given name (default)
# full    = full holder name
# none    = holder name omitted
PUBLIC_HOLDER_NAME_DISCLOSURE=masked

# --- Notifications (optional; console provider used when unset) ---
# SMTP_URL=smtp://user:pass@mail.example.mn:587
# SMTP_FROM=no-reply@diplom.mn

# --- Anchoring (Phase 1; worker skips anchoring when unset) ---
# Daily Merkle root anchor to the AnchorRegistry contract. Testnet values:
# ANCHOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ANCHOR_CHAIN_ID=11155111
# ANCHOR_CONTRACT_ADDRESS=0x189E57eA448D04D684D195BBd9642162042F2441
# Anchor wallet key — gas custody policy is open decision #13; never commit.
# ANCHOR_PRIVATE_KEY=

# --- VC signing (Phase 1; worker skips signing when unset) ---
# Dev only: local P-256 JWK generated by `pnpm --filter @diplommn/did generate:dev`.
# Production signing moves into KMS/HSM on an isolated host — never a file.
# VC_SIGNING_KEY_FILE=packages/did/dev/dev-signing-key.jwk
# VC_ISSUER_DID=did:web:diplom.mn
# VC_KEY_ID=issuer-1
# VC_PUBLIC_BASE_URL=https://diplom.mn
# VC_STATUS_LIST_URL=https://diplom.mn/status/1

# --- HEMIS adapter (Phase 1; validate-source returns 409 when unset) ---
# v1 credentials were leaked in the old repo and MUST be re-provisioned with
# HEMIS before use. Bearer token and/or Basic (base64 user:pass) fallback.
# HEMIS_BASE_URL=https://hub.esis.edu.mn
# HEMIS_BEARER_TOKEN=
# HEMIS_BASIC_AUTH=
# HEMIS_TIMEOUT_MS=10000
