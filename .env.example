# --- Database (docker-compose defaults) ---
DATABASE_URL=postgres://diplommn:diplommn_dev@localhost:5433/diplommn

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO in dev; NDC object storage in prod) ---
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=diplommn
S3_SECRET_KEY=diplommn_dev
S3_BUCKET=diplommn-artifacts

# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
# Cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-0000000000000000
SESSION_TTL_HOURS=12
# Set to "true" only behind HTTPS (production)
COOKIE_SECURE=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# --- Bootstrap platform admin (used once by db:seed; change immediately) ---
BOOTSTRAP_ADMIN_EMAIL=admin@diplom.mn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Now-1234

# --- Public verification disclosure policy (architecture gap #19 — pending legal review) ---
# masked  = surname initial + given name (default)
# full    = full holder name
# none    = holder name omitted
PUBLIC_HOLDER_NAME_DISCLOSURE=masked

# --- Notifications (optional; console provider used when unset) ---
# SMTP_URL=smtp://user:pass@mail.example.mn:587
# SMTP_FROM=no-reply@diplom.mn
