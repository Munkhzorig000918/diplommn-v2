# diplom.mn v2 — production environment (copy to .env.production and fill).
# NEVER commit .env.production. Every secret below rotates via ops process.

# --- Public origin (nginx serves web + api on one domain) ---
PUBLIC_BASE_URL=https://diplom.mn
WEB_ORIGIN=https://diplom.mn
NEXT_PUBLIC_API_URL=https://diplom.mn

# --- Database (compose-internal hostnames) ---
POSTGRES_USER=diplommn
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=diplommn
DATABASE_URL=postgres://diplommn:CHANGE-ME-strong-password@postgres:5432/diplommn

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO in-stack; NDC object storage when available) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE-ME-access-key
S3_SECRET_KEY=CHANGE-ME-secret-key
S3_BUCKET=diplommn-artifacts

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
# openssl rand -hex 32
SESSION_SECRET=CHANGE-ME-64-hex-chars
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
PUBLIC_HOLDER_NAME_DISCLOSURE=masked

# --- Notifications (SMTP required in production; console provider is dev-only) ---
SMTP_URL=smtp://user:pass@mail.example.mn:587
SMTP_FROM=no-reply@diplom.mn

# --- Issuer DID / VC signing ---
# Key history JSON published as /.well-known/did.json. In production the
# PRIVATE key lives in KMS/HSM — VC_SIGNING_KEY_FILE is a dev-grade stopgap
# and must be replaced by the KMS signer before real credentials are issued.
DID_KEY_HISTORY_FILE=/app/secrets/key-history.json
VC_ISSUER_DOMAIN=diplom.mn
VC_ISSUER_DID=did:web:diplom.mn
VC_SIGNING_KEY_FILE=/app/secrets/signing-key.jwk
VC_KEY_ID=issuer-1
VC_PUBLIC_BASE_URL=https://diplom.mn
VC_STATUS_LIST_URL=https://diplom.mn/status/1

# --- Anchoring (Sepolia until the contract audit + mainnet deploy) ---
ANCHOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ANCHOR_CHAIN_ID=11155111
ANCHOR_CONTRACT_ADDRESS=0x189E57eA448D04D684D195BBd9642162042F2441
# Anchor wallet key — custody policy is open decision #13. Never commit.
ANCHOR_PRIVATE_KEY=

# --- HEMIS adapter (credentials must be provisioned fresh with HEMIS) ---
HEMIS_BASE_URL=https://hub.esis.edu.mn
HEMIS_BEARER_TOKEN=
HEMIS_BASIC_AUTH=
HEMIS_TIMEOUT_MS=10000

# --- Bootstrap admin (first boot only; change immediately after login) ---
BOOTSTRAP_ADMIN_EMAIL=admin@diplom.mn
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-once
